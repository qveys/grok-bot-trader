{
  "mode": "paper",
  "bankroll_eur": 500,
  "platforms": {
    "polymarket": {
      "enabled": false,
      "base_url": "https://clob.polymarket.com",
      "trading": false,
      "reason": "Geo-restricted (Belgium / EU). Discovery-only if used; no trading or geo bypass."
    },
    "kalshi": {
      "enabled": false,
      "env": "production",
      "base_url": "https://api.elections.kalshi.com/trade-api/v2",
      "private_key_path": "/workspace/predict-market-bot/secrets/kalshi_private.pem",
      "note": "API key authenticates to production; MODE=paper still blocks live orders",
      "trading": false,
      "reason": "Belgium is a Kalshi Restricted Jurisdiction for Event Contract trading (Member Agreement). No bypass."
    },
    "revolut_x": {
      "enabled": true,
      "trading": false,
      "order_type": "limit_post_only",
      "pairs_whitelist_hint": [
        "BTC-EUR",
        "ETH-EUR",
        "SOL-EUR"
      ],
      "guardian_status": "secrets_ready_paper_cli_ok",
      "legacy_bot_instructions": "/workspace/bot/INSTRUCTIONS.md",
      "guardian_path": "/workspace/predict-market-bot/guardian",
      "note": "Paper first. Live needs explicit user OK. Secrets via process.env only.",
      "secrets_ready": true,
      "secrets_paths": {
        "api_key": "/workspace/predict-market-bot/secrets/revolut_x_api_key",
        "ed25519_private": "/workspace/predict-market-bot/secrets/revolut_x_ed25519_private.pem"
      },
      "cli": "revx",
      "cli_config_dir": "/home/box/.config/revolut-x"
    }
  },
  "scan": {
    "min_volume_contracts": 200,
    "max_days_to_expiry": 30,
    "min_liquidity_usd": 1000,
    "anomaly_price_move_pct": 10,
    "max_spread_cents": 5
  },
  "predict": {
    "min_edge": 0.04,
    "min_confidence": 0.55,
    "applies_to": "live_only",
    "note": "Décision Quentin 9 oct 14h26 : min_edge, min_confidence et la règle des 3× les coûts valent pour le RÉEL seulement. Les simus ne les appliquent pas (petite avance suffit, prix d'arrêt obligatoire, plafond 25 €/simu et 50 € au total)."
  },
  "risk": {
    "kelly_fraction": 0.25,
    "max_position_pct": 0.05,
    "max_concurrent_positions": 15,
    "max_total_exposure_pct": 0.25,
    "max_daily_loss_pct": 0.15,
    "max_drawdown_pct": 0.08,
    "max_slippage_pct": 0.02,
    "max_ai_api_cost_usd_per_day": 50
  },
  "kill_switch_path": "/workspace/predict-market-bot/STOP",
  "jurisdiction_note": "Belgium: no Polymarket/Kalshi event-contract trading. Crypto spot Revolut X is the live path.",
  "primary_venue": "revolut_x",
  "secondary_venue_later": "metamask_onchain",
  "go_nogo": {
    "min_trades": 50,
    "target_trades": 100,
    "min_win_rate": 0.55,
    "min_profit_factor": 1.3,
    "max_drawdown_pct": 0.08,
    "min_sharpe": 1.0,
    "target_sharpe": 1.5,
    "max_daily_loss_pct": 0.15,
    "max_position_pct": 0.05,
    "kelly_fraction": 0.25,
    "live_start_max_exposure_eur": 300,
    "live_review_after_trades": 20
  },
  "official_rules": {
    "grow_capital": true,
    "never_go_bankrupt": true,
    "no_max_trades_per_day": true,
    "trading_journal_mandatory": true,
    "journal_path": "/workspace/predict-market-bot/knowledge/trading_journal.md",
    "expectancy_min_multiple_of_cost": 3,
    "recurring_loss_ban": {
      "same_type_streak": 3,
      "lookback": 10
    },
    "locked_at": "2026-10-07",
    "rules_doc": "/workspace/predict-market-bot/references/regles-litterature.md",
    "decision_log_mandatory": true,
    "decision_log_path": "/workspace/predict-market-bot/knowledge/decision_log.md",
    "logs_split": "decisions_before_buy__trades_after_sell",
    "pairs_whitelist": [
      "BTC-EUR",
      "ETH-EUR",
      "SOL-EUR"
    ],
    "pair_selection_note": "2026-10-07: BTC+ETH+SOL for 15-17 Brussels window; see /workspace/pair_selection_us_open_window.md",
    "expectancy_min_multiple_of_cost_applies_to": "live_only"
  }
}