# predict-market-bot environment template
# NEVER paste real secrets into chat. Use Grok Bot secret-request / process.env.
# Copy to .env locally (gitignored) only on a trusted machine.

# Polymarket CLOB (EIP-712 / L2 API credentials — obtained after wallet auth)
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=

# Kalshi REST (API key id + path to RSA private key PEM used for request signing)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Operating mode mirror (authoritative MODE file still gates scripts)
MODE=paper
