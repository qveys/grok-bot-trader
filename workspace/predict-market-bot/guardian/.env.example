# Revolut X API credentials — placeholders only. Never paste real secrets into chat.
# Load via process.env / secret store on a trusted machine. Copy to .env locally (gitignored).

# API key id / string issued by Revolut X after uploading your public key
REVOLUT_X_API_KEY=

# API secret (if using secret-based auth) OR leave empty when using Ed25519 PEM paths
REVOLUT_X_API_SECRET=

# Preferred: Ed25519 key pair paths (private stays 600 on disk; never commit)
REVOLUT_X_ED25519_PRIVATE_KEY_PATH=
REVOLUT_X_ED25519_PUBLIC_KEY_PATH=

# Optional base URL override (default docs URL — do not hit live from paper scripts)
# REVOLUT_X_BASE_URL=https://revx.revolut.com
