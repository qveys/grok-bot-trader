# Copier en secrets.env puis: chmod 600 secrets.env
# NE JAMAIS coller ces valeurs dans un chat. Elles ne sont jamais affichées ni écrites dans les logs.
#
# Routine PM-Predict (webhook)
SONNETTE_PREDICT_URL=
# Soit la valeur complète de l'en-tête copiée du panneau (ex: "Bearer abc..." ou juste "abc..."):
SONNETTE_PREDICT_AUTH=
# ...soit seulement la clé (sera envoyée comme "Authorization: Bearer <clé>"):
# SONNETTE_PREDICT_KEY=
#
# Routine PM-Risk "Sonnette stop (Risk)" (webhook)
SONNETTE_RISK_URL=
SONNETTE_RISK_AUTH=
# SONNETTE_RISK_KEY=
#
# Options (rarement utiles):
# SONNETTE_KEY_HEADER=Authorization            # ou X-Api-Key, ou "Authorization: Bearer <key>"
# SONNETTE_KEY_MODE=header                     # header | query | body | none
# SONNETTE_KEY_PARAM=key                       # nom du paramètre pour query/body
# SONNETTE_KEY_PREFIX=none                     # enlever "Bearer " avec SONNETTE_*_KEY
# SONNETTE_DRY=1                               # forcer le mode dry (rien n'est envoyé)
