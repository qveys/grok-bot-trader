# Copier vers /workspace/guardian/.env — mode 600
GUARDIAN_MODE=dry_run              # dry_run | live | halt
GUARDIAN_DATA_DIR=/workspace/guardian/data
GUARDIAN_TICK_SECONDS=60
GAME_START=2026-09-01T00:00:00Z    # J+0, à fixer au passage en live

EXCHANGE=revolutx                  # revolutx | bitvavo

# Revolut X : clé API (64 caractères) créée sur exchange.revolut.com/account/api-keys
# avec la clé PUBLIQUE de la paire Ed25519 ; la clé PRIVÉE reste ici, mode 600
REVX_API_KEY=
REVX_PRIVATE_KEY_PATH=/workspace/guardian/secrets/private.pem

# Bitvavo (uniquement si EXCHANGE=bitvavo)
BITVAVO_API_KEY=
BITVAVO_API_SECRET=

# API que le Grok Bot vient interroger (GET /wake, POST /decision)
GUARDIAN_API_TOKEN=                # long token aléatoire : openssl rand -hex 32
GUARDIAN_API_HOST=127.0.0.1        # derrière un reverse proxy TLS uniquement
GUARDIAN_API_PORT=8750
GUARDIAN_WAKE_TIMEOUT_MINUTES=30   # réveil sans réponse -> hold

# 4 paires max, format BTC-EUR ; BTC-EUR, ETH-EUR, SOL-EUR sont toujours incluses
WHITELIST_EXTRA=
