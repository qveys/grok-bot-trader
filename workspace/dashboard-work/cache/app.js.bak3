/* PM Pipeline — Tableau de bord. JS sans dépendance (Chart.js seulement sur Performance). Aucun appel IA. */
(function () {
  "use strict";
  var TZ = "Europe/Brussels";
  var PAGE = document.body.getAttribute("data-page");
  var NAV = [["index", "Accueil"], ["trades", "Trades"], ["performance", "Performance"], ["research", "Analyses"], ["news", "Actualités"], ["about", "À propos"]];
  var STATE = { data: {}, ui: {}, deploy: null };
  var charts = {};

  // ------------------------------------------------------------ format
  function esc(s) { return s == null ? "" : String(s).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }
  function num(v, d) { if (v == null || isNaN(v)) return "—"; return Number(v).toLocaleString("fr-BE", { minimumFractionDigits: d, maximumFractionDigits: d }); }
  function eur(v, d, signed) {
    if (v == null || isNaN(v)) return "—";
    d = d == null ? 2 : d;
    var s = num(Math.abs(v), d) + " €";
    if (signed) return (v > 0 ? "+" : v < 0 ? "−" : "") + s;
    return (v < 0 ? "−" : "") + s;
  }
  function pct(v, d, signed) {
    if (v == null || isNaN(v)) return "—";
    d = d == null ? 2 : d;
    var s = num(Math.abs(v), d) + " %";
    if (signed) return (v > 0 ? "+" : v < 0 ? "−" : "") + s;
    return (v < 0 ? "−" : "") + s;
  }
  function price(v) { if (v == null) return "—"; var d = v >= 1000 ? 2 : v >= 1 ? 2 : 4; return num(v, d) + " €"; }
  function cls(v) { return v == null ? "" : v > 0 ? "pos" : v < 0 ? "neg" : ""; }
  function d(iso) { return iso ? new Date(iso) : null; }
  function fmtTime(iso, withDate) {
    if (!iso) return "—";
    var o = { timeZone: TZ, hour: "2-digit", minute: "2-digit" };
    if (withDate !== false) { o.day = "2-digit"; o.month = "short"; }
    return new Intl.DateTimeFormat("fr-BE", o).format(new Date(iso)).replace(":", "h");
  }
  function fmtDay(iso) { return iso ? new Intl.DateTimeFormat("fr-BE", { timeZone: TZ, weekday: "short", day: "2-digit", month: "short" }).format(new Date(iso)) : "—"; }
  function ago(iso) {
    if (!iso) return "—";
    var s = (Date.now() - new Date(iso).getTime()) / 1000;
    if (s < 0) { s = -s; return "dans " + dur(s); }
    if (s < 45) return "à l'instant";
    return "il y a " + dur(s);
  }
  function dur(s) {
    if (s < 60) return Math.round(s) + " s";
    var m = Math.round(s / 60); if (m < 60) return m + " min";
    var h = Math.floor(m / 60); if (h < 48) return h + " h" + (m % 60 && h < 10 ? " " + String(m % 60).padStart(2, "0") : "");
    return Math.round(h / 24) + " j";
  }
  function badgeMode(m) { return m === "reel" ? '<span class="badge b-real">Réel</span>' : '<span class="badge b-sim">Simulation</span>'; }
  function el(id) { return document.getElementById(id); }

  // ------------------------------------------------------------ Brussels time helpers
  function bxParts(date) {
    var f = new Intl.DateTimeFormat("en-GB", { timeZone: TZ, year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", second: "2-digit", weekday: "short", hour12: false });
    var o = {}; f.formatToParts(date).forEach(function (p) { o[p.type] = p.value; });
    return { y: +o.year, m: +o.month, d: +o.day, h: +o.hour % 24, mi: +o.minute, s: +o.second, wd: ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"].indexOf(o.weekday) };
  }
  function bxOffsetMs(date) { var p = bxParts(date); return Date.UTC(p.y, p.m - 1, p.d, p.h, p.mi, p.s) - Math.floor(date.getTime() / 1000) * 1000; }
  function bxDate(y, m, dd, h, mi) { var guess = new Date(Date.UTC(y, m - 1, dd, h, mi)); return new Date(guess.getTime() - bxOffsetMs(guess)); }
  // Occurrences de créneaux "HH:MM" autour de maintenant (jours ouvrés si demandé)
  function slotWindow(slots, weekdays) {
    if (!slots || !slots.length) return null;
    var now = new Date(), occ = [];
    for (var k = -4; k <= 5; k++) {
      var base = new Date(now.getTime() + k * 86400000), p = bxParts(base);
      if (weekdays && (p.wd === 0 || p.wd === 6)) continue;
      slots.forEach(function (s) { var hm = s.split(":"); occ.push(bxDate(p.y, p.m, p.d, +hm[0], +hm[1])); });
    }
    occ.sort(function (a, b) { return a - b; });
    var prev = null, next = null;
    for (var i = 0; i < occ.length; i++) { if (occ[i] <= now) prev = occ[i]; else { next = occ[i]; break; } }
    return { prev: prev, next: next, progress: prev && next ? (now - prev) / (next - prev) : null };
  }

  // ------------------------------------------------------------ data
  function load(name) {
    return fetch("data/" + name + ".json?t=" + Date.now(), { cache: "no-store" }).then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); });
  }
  var PAGE_DATA = { index: ["summary"], trades: ["trades", "summary"], performance: ["performance", "summary"], research: ["research", "summary"], news: ["news", "summary"], about: ["summary"] };

  function refresh() {
    var names = PAGE_DATA[PAGE] || ["summary"];
    return Promise.all(names.map(load)).then(function (res) {
      names.forEach(function (n, i) { STATE.data[n] = res[i]; });
      renderHeader(); renderPage(); renderFooter();
    }).catch(function (e) {
      if (!STATE.data.summary) el("app").innerHTML = '<div class="notice warn">Impossible de lire les données (' + esc(e.message) + '). Le générateur build.py a-t-il tourné ?</div>';
    });
  }

  // ------------------------------------------------------------ header / footer
  function renderHeader() {
    var s = STATE.data.summary || {};
    var open = el("nav") && el("nav").classList.contains("open");
    el("hdr").innerHTML =
      '<div class="hdr"><a class="brand" href="index.html"><b>PM Pipeline</b><span>TABLEAU DE BORD · ' + esc((s.mode_fr || "").toUpperCase()) + '</span></a>' +
      '<button class="nav-toggle" id="navbtn" aria-label="Menu" aria-expanded="' + (open ? "true" : "false") + '">☰</button>' +
      '<nav class="nav' + (open ? " open" : "") + '" id="nav">' + NAV.map(function (n) { return '<a href="' + n[0] + '.html"' + (n[0] === PAGE ? ' class="active"' : "") + ">" + n[1] + "</a>"; }).join("") + "</nav></div>" +
      '<div class="pricebar" id="pricebar"></div>';
    el("navbtn").onclick = function () { var n = el("nav"); n.classList.toggle("open"); this.setAttribute("aria-expanded", n.classList.contains("open")); };
    renderPriceBar();
  }
  // Prix : data/prices.json (ticks 30 s du collecteur), relu toutes les 30 s. L'âge affiché vient du dernier tick.
  function livePrices() {
    var lp = STATE.data.prices, s = STATE.data.summary || {};
    if (lp && lp.pairs) return lp;
    var out = { pairs: {}, last_tick_at: (s.price_source || {}).at };
    Object.keys(s.prices || {}).forEach(function (k) { out.pairs[k] = { mid: s.prices[k].mid, change_24h_pct: s.prices[k].change_24h_pct, ts: s.prices[k].tick_ts }; });
    return out;
  }
  function tickAge(lp) { return lp && lp.last_tick_at ? (Date.now() - new Date(lp.last_tick_at).getTime()) / 1000 : null; }
  function priceAgeText(lp) {
    var a = tickAge(lp);
    if (a == null) return "";
    if (a < 0) a = 0;
    return "prix d’il y a " + (a < 90 ? Math.round(a) + " s" : dur(a));
  }
  function renderPriceBar() {
    var pbEl = el("pricebar"); if (!pbEl) return;
    var lp = livePrices(), a = tickAge(lp), stale = a == null || a > 120;
    var pb = ["BTC-EUR", "ETH-EUR", "SOL-EUR"].map(function (k) {
      var p = lp.pairs[k]; if (!p) return "";
      return '<span class="pp">' + k.split("-")[0] + " <b>" + price(p.mid) + "</b> " + (p.change_24h_pct != null ? '<span class="' + cls(p.change_24h_pct) + '" title="variation 24 h (' + esc(p.change_source || "") + ')">' + pct(p.change_24h_pct, 1, true) + "</span>" : "") + "</span>";
    }).join("");
    pbEl.innerHTML = '<span class="pp"><span class="dot' + (stale ? "" : " ok") + '"></span>Prix EUR · 24 h</span>' + (pb || '<span class="pp">Prix indisponibles</span>') +
      '<span class="pp ' + (stale ? "warn" : "muted") + '" id="pxage">' + priceAgeText(lp) + (stale && a != null ? " · ancien" : "") + "</span>" +
      '<span class="pp" id="upd">' + updText() + "</span>";
  }
  // Version en ligne (Cloudflare Pages) : data/deploy.json n'existe que dans la copie publiée.
  // Les données n'y changent qu'à chaque publication (~toutes les 15 min), on le dit clairement.
  function hosted() { return !!(STATE.deploy && STATE.deploy.deployed_at); }
  function updText() {
    var s = STATE.data.summary; if (!s) return "";
    if (hosted()) return "Mis à jour " + ago(s.generated_at) + " · version en ligne, publiée toutes les ~" + (STATE.deploy.interval_min || 15) + " min";
    return "Mis à jour " + ago(s.generated_at);
  }
  function renderFooter() {
    el("ftr").innerHTML = "<span>PM Pipeline · tableau de bord personnel de Quentin · heures de Bruxelles</span><span>Simulation ≠ argent réel. Ce n'est pas un conseil financier.</span>";
  }

  // ------------------------------------------------------------ shared blocks
  function statCard(label, value, extra, c) { return '<div class="card"><div class="label">' + label + '</div><div class="mid ' + (c || "") + '">' + value + "</div>" + (extra ? '<div class="xs muted">' + extra + "</div>" : "") + "</div>"; }
  function secHead(t, sub) { return '<div class="sec-head"><h2>' + t + "</h2>" + (sub ? '<span class="sub">' + sub + "</span>" : "") + "</div>"; }

  // ------------------------------------------------------------ HOME
  function renderHome() {
    var s = STATE.data.summary, p = s.paper, r = s.real, ru = s.rules;
    var h = "";
    h += '<div class="topline"><span class="badge ' + (s.mode === "paper" ? "b-sim" : "b-real") + '">Mode : ' + esc(s.mode_fr) + "</span>" +
      '<span class="badge ' + (ru.stop_file || ru.halted_file ? "b-err" : "b-ok") + '">Arrêt d\'urgence : ' + (ru.stop_file ? "OUI" : ru.halted_file ? "BLOQUÉ" : "non") + "</span>" +
      '<span class="badge ' + (ru.live_today >= ru.max_live_per_day ? "b-warn" : "b-mute") + '">Achats réels aujourd\'hui : ' + ru.live_today + " / " + ru.max_live_per_day + "</span>" +
      '<span class="badge b-mute">Achat réel préparé : ' + (ru.live_once_armed ? "oui" : "non") + "</span></div>";

    // Portefeuilles
    h += '<section class="section">' + secHead("Portefeuilles", "Simulation et argent réel sont séparés") + '<div class="grid g2">';
    h += '<div class="card"><div class="card-title"><h3>Portefeuille simulé</h3><span class="badge b-sim">Simulation</span></div>' +
      '<div class="flow"><div><div class="label">Départ</div><div class="mid text2">' + eur(p.invested_eur) + '</div></div><div class="arrow">→</div>' +
      '<div><div class="label">Solde</div><div class="big">' + eur(p.balance_eur) + "</div></div></div>" +
      '<div style="margin:6px 0 2px" class="label">Gain / perte total</div><div class="mid ' + cls(p.total_return_eur) + '">' + eur(p.total_return_eur, 2, true) + " (" + pct(p.total_return_pct, 2, true) + ")</div>" +
      '<hr class="sep"><div class="kv k3">' +
      kv("Liquidités", eur(p.cash_eur)) + kv("En positions", eur(p.in_positions_eur)) + kv("Gain réalisé", '<span class="' + cls(p.realized_pnl_eur) + '">' + eur(p.realized_pnl_eur, 2, true) + "</span>") +
      kv("Taux de réussite", p.win_rate_pct == null ? "—" : pct(p.win_rate_pct, 0)) + kv("Trades terminés", p.trades_closed) + kv("Positions ouvertes", p.open_positions) + "</div>" +
      '<div style="margin-top:14px"><div class="flow small text2" style="justify-content:space-between"><span>Capital utilisé</span><span class="mono">' + pct(p.deployed_pct, 1) + " / plafond " + pct(p.cap_pct, 0) + "</span></div>" +
      '<div class="bar"><i style="width:' + Math.min(100, p.cap_pct ? p.deployed_pct / p.cap_pct * 100 : 0) + '%"></i></div></div>' +
      (p.open_list.length ? '<div class="small" style="margin-top:10px">' + p.open_list.map(function (o) { return "<div>" + esc(o.pair) + " · acheté " + price(o.buy_price) + " · valeur " + eur(o.value_eur) + " · stop " + price(o.stop_price) + "</div>"; }).join("") + "</div>" : "") +
      '<div class="xs muted" style="margin-top:10px">Dernier mouvement ' + fmtTime(p.updated_at) + " · baisse depuis le sommet " + pct(p.drawdown_pct, 2) + (p.autotest_excluded ? " · l'auto-test technique du 6 oct. n'est pas compté" : "") + "</div></div>";

    h += realCard(r, true);
    h += "</div></section>";
    if (s.sellable && !s.sellable.hidden) h += '<section class="section">' + secHead("Argent réel : ce que le bot gère et ce qu’on peut vendre", "lecture seule") + '<div class="grid g2">' + equityCard(s.live_equity) + sellableCard(s.sellable) + "</div></section>";
    h += '<section class="section">' + secHead("Sonnette", "réveil des bots quand un prix bouge") + sonnetteCard(s.sonnette) + "</section>";

    // Règles
    h += '<section class="section">' + secHead("Règles de sécurité", "Vérifiées avant chaque achat") + '<div class="grid g4">' +
      rule("🛡️", ru.max_live_per_day + " achat réel / jour", "maximum") + rule("⛔", "Stop à −" + num(ru.max_daily_loss_pct, 0) + " %", "de perte sur la journée") +
      rule("📉", "Arrêt à −" + num(ru.max_drawdown_pct, 0) + " %", "de baisse depuis le sommet") + rule("⚖️", "Gain ≥ " + ru.expectancy_multiple + "× les coûts", "sinon on n'achète pas") +
      "</div></section>";

    // Cycles
    h += '<section class="section">' + secHead("Cycles automatiques", esc(s.status_line)) + '<div class="grid g3" id="cycles">' + s.cycles.map(cycleCard).join("") + "</div></section>";

    // Log
    h += '<section class="section">' + secHead("Suivi des cycles — journal", "derniers passages (fichiers et journaux de l'équipe)") + '<div id="logf" class="chips" style="margin-bottom:12px"></div><div id="logt"></div></section>';
    el("app").innerHTML = h;
    renderLog();
  }

  // ------------------------------------------------------------ ARGENT RÉEL (bloc partagé)
  function realStatsKv(st) {
    st = st || {};
    return '<div class="kv k3">' +
      kv("Gain réalisé", '<span class="' + cls(st.realized_pnl_eur) + '">' + eur(st.realized_pnl_eur || 0, 2, true) + "</span>") +
      kv("Taux de réussite", st.win_rate_pct == null ? "—" : pct(st.win_rate_pct, 0)) +
      kv("Trades terminés", st.closed || 0) +
      kv("Positions ouvertes", (st.open_positions_count || 0) + (st.open_positions_count ? " · " + eur(st.open_positions_value_eur) : "")) +
      kv("Gain / perte latent", '<span class="' + cls(st.unrealized_pnl_eur) + '">' + eur(st.unrealized_pnl_eur || 0, 2, true) + "</span>") +
      kv("Ordres en attente", (st.open_orders_count || 0) + (st.open_orders_count ? " · " + eur(st.open_orders_eur) : "")) + "</div>";
  }
  function realCard(r, compact) {
    if (!r || r.hidden) return '<div class="card"><div class="card-title"><h3>Argent réel</h3><span class="badge b-real">Réel</span></div><div class="notice">Soldes réels masqués (SHOW_REAL=false). Normal pour une version publique.</div></div>';
    var rv = r.revolut, mm = r.metamask, st = r.stats || {};
    var h = '<div class="card"><div class="card-title"><h3>Argent réel</h3><span class="badge b-real">Réel · lecture seule</span></div>' +
      '<div class="label">Total estimé aujourd’hui</div><div class="big">' + eur(r.total_eur) + '</div><div class="xs muted">Revolut X + MetaMask, au prix actuel</div><hr class="sep">' +
      '<div class="flow" style="justify-content:space-between;margin-bottom:8px"><b>Trades réels depuis le ' + fmtDay(r.project_start) + '</b>' + ((st.closed || st.open_positions_count || st.open_orders_count) ? "" : '<span class="badge b-mute">aucun pour l’instant</span>') + "</div>" + realStatsKv(st) +
      '<div class="xs muted" style="margin-top:6px">Calcul automatique depuis l’historique Revolut X (achats et ventes appariés dans l’ordre). Trades lancés par les bots : ' + (st.bot_trades || 0) + "." + (r.history_stale ? ' <span class="warn">Historique pas à jour (dernier relevé gardé).</span>' : "") + "</div>";
    if ((r.open_positions || []).length) h += '<div class="small" style="margin-top:8px">' + r.open_positions.map(function (o) { return "<div>" + esc(o.pair) + " · acheté " + price(o.buy_price) + " · " + num(o.qty, 6) + " · valeur " + eur(o.value_eur) + ' · <span class="' + cls(o.pnl_eur) + '">' + eur(o.pnl_eur, 2, true) + "</span></div>"; }).join("") + "</div>";
    if ((r.open_orders || []).length) h += '<div class="small" style="margin-top:8px">' + r.open_orders.map(function (o) { return "<div>Ordre en attente : " + (o.side === "buy" ? "achat" : "vente") + " " + esc(o.pair) + " à " + price(o.price) + " (" + eur(o.amount_eur) + ")" + (o.bot ? " · bot" : "") + "</div>"; }).join("") + "</div>";
    h += '<hr class="sep">';
    if (rv) {
      h += '<div class="flow" style="justify-content:space-between"><b>Revolut X — avoirs</b><span class="mono">' + eur(rv.total_eur) + (rv.stale ? ' <span class="badge b-warn">ancien</span>' : "") + "</span></div>" +
        '<div class="table-wrap"><table class="mini"><tbody>' + rv.assets.map(function (a) {
          return "<tr><td class='mono'>" + esc(a.currency) + "</td><td class='num'>" + num(a.qty, a.currency === "EUR" ? 2 : 6) + (a.staked ? "<div class='xs muted'>dont " + num(a.staked, 6) + " en staking</div>" : "") + "</td><td class='num'>" + eur(a.value_eur) + "</td></tr>";
        }).join("") + "</tbody></table></div>";
    }
    if ((r.start_holdings || []).length) {
      var f = r.flows || {}, rw = f.rewards || {};
      h += '<details><summary><span>Avoirs de départ (' + fmtDay(r.project_start) + ')</span></summary><div class="inner"><p class="xs" style="margin-top:0">Ce que le compte contenait au début du projet (achats d’avant, staking…). Ce ne sont pas des trades. Calcul : solde actuel − mouvements depuis le début.</p><div class="table-wrap"><table class="mini"><tbody>' +
        r.start_holdings.map(function (a) { return "<tr><td class='mono'>" + esc(a.currency) + "</td><td class='num'>" + num(a.qty, a.currency === "EUR" ? 2 : 6) + "</td><td class='num'>" + eur(a.value_now_eur) + "<div class='xs muted'>valeur actuelle</div></td></tr>"; }).join("") + "</tbody></table></div>" +
        '<p class="xs" style="margin-bottom:0"><b>Mouvements depuis :</b> dépôts ' + eur(f.deposits_eur || 0) + " · retraits " + eur(f.withdrawals_eur || 0) +
        (Object.keys(rw).length ? " · récompenses de staking " + Object.keys(rw).map(function (k) { return num(rw[k], 8) + " " + esc(k); }).join(", ") : "") + "</p></div></details>";
    }
    if (mm) h += '<div class="flow" style="justify-content:space-between;margin-top:10px"><b>MetaMask (Arbitrum)</b><span class="mono">' + eur(mm.value_eur) + (mm.stale ? ' <span class="badge b-warn">ancien</span>' : "") + "</span></div>" +
      '<div class="small text2 mono">' + num(mm.eth, 6) + " ETH</div><div class='xs muted break'>" + esc(mm.address) + "</div>";
    var mt = r.metamask_trades || {};
    h += '<div class="xs muted" style="margin-top:6px">' + esc(mt.tracked ? "Suivi des trades MetaMask : " + (mt.files || []).join(", ") : (mt.text || "Suivi des trades MetaMask : pas encore")) + "</div>";
    h += '<div class="xs muted" style="margin-top:8px">Lu ' + ago((rv || mm || {}).fetched_at) + ((r.errors || []).concat(r.history_errors || []).length ? ' · <span class="warn">' + esc((r.errors || []).concat(r.history_errors || []).join(" / ")) + "</span>" : "") + "</div></div>";
    return h;
  }

  // ------------------------------------------------------------ ARGENT RÉEL : pièces disponibles + capital du bot
  function coinQty(v) { return v == null ? "—" : num(v, v >= 1 ? 4 : 6); }
  function sellableCard(sl) {
    if (!sl || sl.hidden) return "";
    var all = sl.rows || [], rows = all.filter(function (r) { return !r.dust; }), dust = all.filter(function (r) { return r.dust; });
    var h = '<div class="card"><div class="card-title"><h3>Pièces disponibles à vendre</h3><span class="badge b-real">Réel</span></div>' +
      '<p class="xs muted" style="margin-top:0">« Disponible » = on peut le vendre tout de suite. « Bloqué » = en staking (il faut d’abord le débloquer).</p>';
    h += rows.length ? '<div class="table-wrap"><table class="rtable"><thead><tr><th>Où</th><th>Pièce</th><th class="num">Disponible</th><th class="num">Bloqué</th><th class="num">Valeur dispo</th></tr></thead><tbody>' +
      rows.map(function (r) {
        return '<tr' + (r.dust ? ' class="muted"' : "") + '><td data-label="Où" class="small">' + esc(r.where) + (r.note ? '<div class="xs muted">' + esc(r.note) + "</div>" : "") + '</td><td data-label="Pièce" class="mono">' + esc(r.currency) +
          '</td><td data-label="Disponible" class="num">' + coinQty(r.available) + (r.reserved_orders ? '<div class="xs muted">dont ' + coinQty(r.reserved_orders) + " dans un ordre</div>" : "") +
          '</td><td data-label="Bloqué" class="num">' + (r.blocked_staking ? coinQty(r.blocked_staking) + '<div class="xs muted">' + eur(r.blocked_eur) + "</div>" : "0") +
          '</td><td data-label="Valeur dispo" class="num">' + eur(r.available_eur) + (r.dust ? '<div class="xs muted">poussière</div>' : '<div class="xs muted">à ' + price(r.price_eur) + "</div>") + "</td></tr>";
      }).join("") + "</tbody></table></div>" : '<p class="empty">Aucune pièce.</p>';
    if (dust.length) h += '<div class="xs muted">Petits restes (trop peu pour être vendus) : ' + dust.map(function (r) { return esc(r.currency) + " " + coinQty(r.available) + " (" + eur(r.available_eur) + ")"; }).join(" · ") + "</div>";
    h += '<div class="flow small" style="justify-content:space-between;margin-top:8px"><span>Total disponible</span><b class="mono">' + eur(sl.total_available_eur) + '</b></div>' +
      '<div class="flow xs muted" style="justify-content:space-between"><span>Bloqué en staking</span><span class="mono">' + eur(sl.total_blocked_eur) + "</span></div>" +
      '<div class="xs muted" style="margin-top:6px">Lu ' + ago(sl.fetched_at) + (sl.stale ? ' · <span class="warn">ancien</span>' : "") + " · valeur au dernier prix connu.</div></div>";
    return h;
  }
  function equityCard(le) {
    if (!le || le.hidden) return "";
    if (!le.present) return '<div class="card"><div class="card-title"><h3>Capital réel du bot</h3><span class="badge b-real">Réel</span></div><p class="empty">Pas encore de fichier state/live_equity.json.</p></div>';
    var hb = le.hors_bot || {}, ks = Object.keys(hb);
    return '<div class="card"><div class="card-title"><h3>Capital réel du bot</h3><span class="badge ' + (le.stale ? "b-warn" : "b-real") + '">' + (le.stale ? "pas à jour" : "Réel") + "</span></div>" +
      '<div class="label">Argent que le bot gère</div><div class="big">' + eur(le.capital_reel) + "</div>" +
      '<div class="xs muted">euros dispo ' + eur(le.eur_available) + " + réservés " + eur(le.eur_reserved) + " + pièces achetées par le bot " + eur(le.bot_positions_value) + "</div>" +
      '<hr class="sep"><div class="kv k3">' +
      kv("Perte du jour", '<span class="' + cls(-(le.perte_jour_pct || 0)) + '">' + pct(le.perte_jour_pct, 2) + "</span>") +
      kv("Baisse depuis le plus haut", le.baisse_depuis_plus_haut_pct == null ? "— <span class='xs muted'>(pas encore de plus haut)</span>" : pct(le.baisse_depuis_plus_haut_pct, 2)) +
      kv("Référence du jour", le.ref_jour ? eur(le.ref_jour.valeur) : "—") + "</div>" +
      '<hr class="sep"><div class="flow" style="justify-content:space-between"><b>Pièces de Quentin mises de côté</b><span class="mono">' + eur(le.hors_bot_eur) + "</span></div>" +
      '<p class="xs muted" style="margin:2px 0 6px">Pas gérées par le bot (photo prise ' + (le.hors_bot_depuis ? fmtTime(le.hors_bot_depuis) : "au premier lancement") + ").</p>" +
      (ks.length ? '<div class="small mono">' + ks.map(function (k) { return "<div>" + esc(k) + " " + coinQty(hb[k].qty) + ' <span class="muted">· ' + eur(hb[k].eur) + "</span></div>"; }).join("") + "</div>" : "") +
      '<div class="xs muted" style="margin-top:8px">Calculé ' + ago(le.ts) + (le.stale ? ' · <span class="warn">ancien (plus de 15 min ou marqué « pas à jour »)</span>' : "") + " · source : state/live_equity.json</div></div>";
  }

  // ------------------------------------------------------------ SONNETTE
  function sonnetteCard(so) {
    if (!so) return "";
    var h = '<div class="card"><div class="card-title"><h3>Sonnette</h3>' + (so.present ? '<span class="badge ' + (so.running ? "b-ok" : "b-err") + '"><span class="dot' + (so.running ? " ok" : "") + '"></span>' + (so.running ? "en marche" : "arrêtée") + "</span>" : '<span class="badge b-mute">pas trouvée</span>') + "</div>" +
      '<p class="xs muted" style="margin-top:0">Réveille PM-Predict ou PM-Risk quand un prix touche une zone ou qu’un stop est proche. Elle ne passe aucun ordre.</p>';
    if (so.present) {
      var md = function (m) { return '<span class="badge ' + (m === "branchée" ? "b-ok" : "b-mute") + '">' + esc(m) + "</span>"; };
      h += '<div class="kv k3">' + kv("PM-Predict", md(so.predict_mode)) + kv("PM-Risk", md(so.risk_mode)) + kv("Dernier signe de vie", ago(so.heartbeat)) +
        kv("Aujourd’hui · Predict", (so.today.predict.real || 0) + " envoyée(s) · " + (so.today.predict.dry || 0) + " à blanc") +
        kv("Aujourd’hui · Risk", (so.today.risk.real || 0) + " envoyée(s) · " + (so.today.risk.dry || 0) + " à blanc") +
        kv("Fenêtre Predict", so.predict_window_open ? "ouverte" : "fermée") + "</div>";
      var tdy = (so.today && so.today.date) || "", rgt = (so.rings || []).filter(function (r) { return r.at && new Intl.DateTimeFormat("en-CA", { timeZone: TZ }).format(new Date(r.at)) === tdy; });
      h += '<div class="xs muted" style="margin-top:6px">Compteurs ci-dessus : ceux de la sonnette (alertes de zones et de stops). Journal du jour : ' + rgt.length + " coup(s), dont " + rgt.filter(function (r) { return r.test; }).length + " essai(s).</div>";
      var warns = [];
      if (so.urgent_active) warns.push("alerte urgente en cours");
      if (so.prices_stale) warns.push("prix pas à jour");
      if (so.real_positions_without_stop) warns.push(so.real_positions_without_stop + " position(s) réelle(s) sans stop");
      if (so.zones_problems) warns.push(so.zones_problems + " zone(s) mal écrite(s)");
      if (!so.collector_running) warns.push("collecteur de prix arrêté");
      if (warns.length) h += '<div class="notice warn" style="margin-top:10px">' + esc(warns.join(" · ")) + "</div>";
    }
    var zs = (so.zones || []).filter(function (z) { return z.active; });
    h += '<hr class="sep"><b class="small">Zones de réveil actives (' + zs.length + ")</b>" +
      (zs.length ? '<div class="small" style="margin-top:6px">' + zs.map(function (z) { return '<div><span class="mono">' + esc(z.pair) + "</span> " + (String(z.side).indexOf("sous") === 0 || z.side === "below" ? "passe sous" : "passe au-dessus de") + " <b>" + price(z.price) + "</b> → " + esc(z.bot || "") + (z.reason ? ' <span class="xs muted">· ' + esc(z.reason) + "</span>" : "") + (z.expire ? ' <span class="xs muted">· jusqu’à ' + fmtTime(z.expire) + "</span>" : "") + "</div>"; }).join("") + "</div>" : '<div class="xs muted" style="margin-top:4px">Aucune zone pour l’instant (state/zones_reveil.json).</div>');
    var rg = so.rings || [];
    h += '<hr class="sep"><b class="small">Derniers coups de sonnette</b>' + (rg.length ? '<div class="table-wrap" style="margin-top:6px"><table class="rtable"><thead><tr><th>Heure</th><th>Bot</th><th>Résultat</th><th>Message</th></tr></thead><tbody>' +
      rg.slice(0, 6).map(function (r) {
        var b = r.result === "delivered" ? "b-ok" : r.result === "failed" ? "b-err" : "b-mute";
        return '<tr><td data-label="Heure" class="mono small">' + fmtTime(r.at) + '</td><td data-label="Bot" class="mono">' + esc(r.bot === "risk" ? "PM-Risk" : r.bot === "predict" ? "PM-Predict" : r.bot) + '</td><td data-label="Résultat"><span class="badge ' + b + '">' + esc(r.result_fr) + "</span>" + (r.http_status && r.result === "failed" ? ' <span class="xs muted">(code ' + r.http_status + ")</span>" : "") +
          '</td><td data-label="Message" class="wide small">' + (r.test ? '<span class="badge b-mute">essai</span> ' : "") + esc(r.message) + (r.pair ? ' <span class="mono xs">' + esc(r.pair) + (r.price ? " " + price(r.price) : "") + "</span>" : "") + "</td></tr>";
      }).join("") + "</tbody></table></div>" : '<div class="xs muted" style="margin-top:4px">Aucun coup de sonnette.</div>');
    h += '<div class="xs muted" style="margin-top:6px">Source : tools/sonnette/state (état + journal des sonneries). Adresses et clés jamais affichées.</div></div>';
    return h;
  }

  // ------------------------------------------------------------ VENDRE D'ABORD (D-018)
  function sfStatsGrid(st) {
    st = st || {};
    var coins = st.coins_gained || {}, ck = Object.keys(coins);
    return '<div class="grid g4">' + statCard("Cycles", st.cycles || 0, (st.done || 0) + " terminé(s) · " + (st.open || 0) + " en attente du rachat") +
      statCard("Réussite", st.win_rate_pct == null ? "—" : pct(st.win_rate_pct, 0), (st.wins || 0) + " avec plus de pièces · " + (st.losses || 0) + " avec moins") +
      statCard("Pièces gagnées / perdues", ck.length ? ck.map(function (k) { return '<span class="' + cls(coins[k]) + '">' + (coins[k] > 0 ? "+" : "") + coinQty(coins[k]) + " " + esc(k) + "</span>"; }).join("<br>") : "0", "après rachat") +
      statCard("Résultat en euros", eur(st.eur_gain || 0, 2, true), "valeur au prix du rachat, frais compris", cls(st.eur_gain)) + "</div>";
  }
  function sfTable(cycles) {
    if (!cycles.length) return '<p class="empty">Aucun cycle vendre d’abord pour l’instant.</p>';
    return '<div class="table-wrap"><table class="rtable"><thead><tr><th>Type</th><th>Paire</th><th>1. Vente</th><th>2. Rachat</th><th class="num">Pièces</th><th class="num">Résultat pièces</th><th class="num">Résultat €</th><th>Statut</th></tr></thead><tbody>' +
      cycles.map(function (c) {
        var done = c.done;
        return '<tr><td data-label="Type">' + badgeMode(c.mode) + ' <span class="badge b-info">vente puis achat</span>' + (c.decision_id ? ' <span class="xs muted">' + esc(c.decision_id) + "</span>" : "") +
          '</td><td data-label="Paire" class="mono">' + esc(c.pair) +
          '</td><td data-label="1. Vente" class="mono">' + price(c.sell_price) + '<div class="xs muted">' + fmtTime(c.sell_time) + (c.sell_eur ? " · " + eur(c.sell_eur) : "") + "</div>" +
          '</td><td data-label="2. Rachat" class="mono">' + (done ? price(c.rebuy_price) + '<div class="xs muted">' + fmtTime(c.rebuy_time) + (c.rebuy_reason ? " · " + esc(c.rebuy_reason) : "") + "</div>" :
            '<span class="small">visé ' + price(c.target_price) + '</span><div class="xs muted">sécurité ' + price(c.safety_price) + "</div>") +
          '</td><td data-label="Pièces" class="num">vendu ' + coinQty(c.qty_sold) + (done ? "<div>racheté " + coinQty(c.qty_bought) + "</div>" : "") +
          '</td><td data-label="Résultat pièces" class="num ' + cls(done ? c.coin_gain : c.coin_gain_if_now) + '">' + (done ? (c.coin_gain == null ? "—" : (c.coin_gain > 0 ? "+" : "") + coinQty(c.coin_gain) + " " + esc(c.coin) + '<div class="xs">' + pct(c.coin_gain_pct, 2, true) + "</div>") :
            (c.coin_gain_if_now == null ? "—" : '<span class="xs muted">si racheté maintenant</span><div>' + (c.coin_gain_if_now > 0 ? "+" : "") + coinQty(c.coin_gain_if_now) + " " + esc(c.coin) + "</div>")) +
          '</td><td data-label="Résultat €" class="num ' + cls(done ? c.eur_gain : c.eur_gain_if_now) + '">' + (done ? eur(c.eur_gain, 2, true) + (c.fees_eur ? '<div class="xs muted">frais ' + eur(c.fees_eur) + "</div>" : "") : (c.eur_gain_if_now == null ? "—" : '<span class="xs muted">latent</span><div>' + eur(c.eur_gain_if_now, 2, true) + "</div>")) +
          '</td><td data-label="Statut"><span class="badge ' + (done ? ((c.coin_gain || 0) >= 0 ? "b-ok" : "b-err") : "b-warn") + '">' + esc(c.status) + "</span>" + (c.inferred ? '<div class="xs muted">vente sans achat avant : comptée comme « vendre d’abord »</div>' : "") + (c.reason ? '<div class="xs muted">' + esc(c.reason) + "</div>" : "") + "</td></tr>";
      }).join("") + "</tbody></table></div>";
  }
  function sfSection(SF, withDecisions) {
    SF = SF || { cycles: [], stats: {}, decisions: [] };
    var h = '<div class="notice" style="margin-bottom:12px"><b>Vendre d’abord (idée D-018)</b> : on vend une partie des pièces qu’on a déjà quand le prix a monté, puis on les rachète plus bas (objectif ' + pct((SF.rule || {}).target_pct, 1, true) + "). Si le prix monte encore de " + pct((SF.rule || {}).safety_pct, 1) + ", on rachète quand même (rachat de sécurité). Le but : finir avec <b>plus de pièces</b>.</div>";
    h += sfStatsGrid((SF.stats || {}).all);
    h += '<div style="margin-top:12px">' + sfTable(SF.cycles || []) + "</div>";
    if (withDecisions) {
      h += '<h3 style="margin-top:18px">Décisions « vendre d’abord » (carnet des décisions)</h3>' + ((SF.decisions || []).length ? SF.decisions.map(decCard).join("") : '<p class="empty">Aucune décision D-018 lisible.</p>');
    }
    h += '<p class="xs muted">Source : ' + esc(SF.source || "state/trades_log.jsonl") + " ; décisions : knowledge/decision_log.md.</p>";
    return h;
  }
  function srTestsHtml(tests, dups) {
    if (!tests || !tests.length) return '<p class="empty">Pas encore de test du passé pour « vendre d’abord ». Ils apparaîtront ici automatiquement.</p>';
    var lim = STATE.ui.srLimit || 4, all = tests;
    tests = tests.slice(0, lim);
    return '<div class="grid g2">' + tests.map(function (t) {
      return '<div class="card flat"><div class="card-title" style="margin-bottom:4px"><div class="mono small"><b>' + esc(t.pair) + "</b> · " + esc(t.timeframe) + ' <span class="xs muted">· ' + fmtTime(t.time) + "</span></div>" + (t.status && t.status !== "ok" ? '<span class="badge b-warn">' + esc(t.status) + "</span>" : "") + "</div>" +
        '<div class="xs muted">' + esc((t.conditions || []).join(" · ")) + " · " + esc((t.period || []).join(" → ")) + "</div>" +
        '<div class="xs muted">Frais : ' + esc(t.costs_fr || "?") + "</div>" +
        (t.robust ? '<div style="margin-top:6px"><span class="badge ' + (/ROBUST|SOLIDE|OUI|YES/i.test(t.robust.verdict || "") ? "b-ok" : /FRAGILE/i.test(t.robust.verdict || "") ? "b-warn" : "b-err") + '">Test de solidité : ' + esc((t.robust.verdict_fr || "").split(" :")[0] || t.robust.verdict || "?") + (t.robust.passed != null ? " · " + t.robust.passed + "/" + t.robust.of + " vérifications" : "") + "</span></div>" : "") +
        (t.summary_fr ? '<p class="small" style="margin:8px 0">' + esc(t.summary_fr) + "</p>" : "") +
        (t.robust ? '<div class="xs muted" style="margin-bottom:6px">' + [t.robust.windows_n ? "périodes gagnantes " + t.robust.windows_gain + "/" + t.robust.windows_n : "", t.robust.pbo != null ? "risque que ce soit de la chance (PBO) " + pct(t.robust.pbo * 100, 0) : "", t.robust.random_p != null ? "mieux que vendre au hasard ? " + (t.robust.random_p < 0.05 ? "oui" : "non") : ""].filter(Boolean).join(" · ") + "</div>" : "") +
        '<div class="kv k3">' + kv("Pièces vs garder", '<span class="' + cls(t.coin_gain_pct) + '">' + pct(t.coin_gain_pct, 2, true) + "</span>") +
        kv("Euros vs garder", '<span class="' + cls(t.eur_gain_vs_hold) + '">' + eur(t.eur_gain_vs_hold, 2, true) + "</span>") +
        kv("Cycles", t.cycles + (t.win_rate_pct != null ? " · " + pct(t.win_rate_pct, 0) + " gagnés" : "")) +
        kv("Rachats", (t.rebuy_reasons.target || 0) + " visés · " + (t.rebuy_reasons.safety || 0) + " sécurité") +
        kv("Pire baisse (pièces)", pct(t.max_drawdown_coins_pct, 1)) + kv("Frais payés", eur(t.fees_eur)) + "</div>" +
        '<div style="margin-top:8px">' + (t.verdict || []).map(function (v) { var good = /^(plus|mieux|gain ≥|baisse max <|assez)/.test(v); return '<span class="badge ' + (good ? "b-ok" : "b-err") + '" style="margin:2px">' + esc(v) + "</span>"; }).join("") + "</div></div>";
    }).join("") + "</div>" + (all.length > lim ? '<button class="btn" id="srmore" style="margin-top:10px">Voir tous les tests de cette idée (' + all.length + ")</button>" : "") +
      (dups ? '<p class="xs muted">' + dups + " test(s) en double (mêmes réglages) cachés.</p>" : "");
  }

  function kv(l, v) { return '<div><div class="label">' + l + '</div><div class="mono">' + v + "</div></div>"; }
  function rule(i, b, t) { return '<div class="rule"><span class="ico">' + i + "</span><div><b>" + b + '</b><span class="small text2">' + t + "</span></div></div>"; }
  function cycleState(c) {
    if (c.every_sec) {
      var age = c.last_run ? (Date.now() - new Date(c.last_run)) / 1000 : null;
      var ok = c.last_ok && age != null && age < c.every_sec * 6;
      return { badge: ok ? '<span class="badge b-ok">En marche</span>' : '<span class="badge b-err">Arrêté</span>', prog: age == null ? null : Math.min(1, (age % c.every_sec) / c.every_sec), next: null };
    }
    var w = slotWindow(c.slots, c.weekdays);
    if (!w) return { badge: '<span class="badge b-mute">Sur demande</span>', prog: null, next: null };
    var inWin = false;
    if (c.key === "scan") { var p = bxParts(new Date()), mins = p.h * 60 + p.mi; inWin = p.wd > 0 && p.wd < 6 && mins >= 900 && mins <= 1020; }
    var badge = c.key === "scan" ? (inWin ? '<span class="badge b-ok">En séance</span>' : '<span class="badge b-mute">Hors fenêtre</span>') : '<span class="badge b-info">Planifié</span>';
    return { badge: badge, prog: w.progress, next: w.next };
  }
  function cycleCard(c) {
    var st = cycleState(c);
    return '<div class="card cycle" data-key="' + c.key + '"><div class="head"><div><h3>' + esc(c.name) + '</h3><div class="t">' + esc(c.title) + "</div></div>" + st.badge + "</div>" +
      '<div class="sched">⏱ ' + esc(c.schedule) + "</div>" +
      (st.prog != null ? '<div class="flow xs text2" style="justify-content:space-between"><span>cycle écoulé</span><span class="mono">' + Math.round(st.prog * 100) + ' %</span></div><div class="bar"><i style="width:' + Math.round(st.prog * 100) + '%"></i></div>' : "") +
      '<p class="small" style="margin:10px 0 0">' + esc(c.desc) + "</p><ul>" + c.bullets.map(function (b) { return "<li>" + esc(b) + "</li>"; }).join("") + "</ul>" +
      (c.last_note ? '<div class="xs ' + (c.last_ok ? "muted" : "warn") + '">' + esc(c.last_note) + "</div>" : "") +
      '<div class="foot"><span>Dernier passage : <b class="' + (c.last_ok ? "" : "warn") + '">' + ago(c.last_run) + "</b></span><span>" + (st.next ? "Prochain : " + fmtDay(st.next.toISOString()) + " " + fmtTime(st.next.toISOString(), false) : fmtTime(c.last_run)) + "</span></div>" +
      (c.key === "risk" ? '<div class="xs muted" style="margin-top:4px">Surveillance des stops : ' + (c.watch_stops_running ? "en marche" : "pas de programme actif détecté (aucune position ouverte)") + "</div>" : "") +
      "</div>";
  }
  function renderLog() {
    var s = STATE.data.summary, f = STATE.ui.logFilter || "Tous", lim = STATE.ui.logLimit || 15;
    var names = ["Tous"].concat(Array.from(new Set(s.log.map(function (e) { return e.script.replace(/ \(.*\)$/, ""); }))));
    el("logf").innerHTML = names.map(function (n) { return '<button class="chip' + (n === f ? " on" : "") + '" data-f="' + esc(n) + '">' + esc(n) + "</button>"; }).join("");
    Array.prototype.forEach.call(el("logf").querySelectorAll("button"), function (b) { b.onclick = function () { STATE.ui.logFilter = b.getAttribute("data-f"); STATE.ui.logLimit = 15; renderLog(); }; });
    var rows = s.log.filter(function (e) { return f === "Tous" || e.script.indexOf(f) === 0; });
    var st = function (x) { return x === "OK" ? "b-ok" : x === "ERREUR" ? "b-err" : x === "ALERTE" ? "b-warn" : "b-mute"; };
    var h = '<div class="table-wrap"><table class="rtable"><thead><tr><th>Programme</th><th>Début</th><th class="num">Durée</th><th class="num">Signaux</th><th class="num">Trades</th><th>Statut</th><th>Notes</th></tr></thead><tbody>' +
      rows.slice(0, lim).map(function (e) {
        return '<tr><td data-label="Programme" class="mono">' + esc(e.script) + '</td><td data-label="Début" class="mono" title="' + esc(fmtTime(e.started)) + '">' + ago(e.started) + '<div class="xs muted">' + fmtTime(e.started) + '</div></td><td data-label="Durée" class="num">' + (e.duration != null ? esc(e.duration) : "") +
          '</td><td data-label="Signaux" class="num">' + (e.signals != null ? e.signals : "") + '</td><td data-label="Trades" class="num">' + (e.trades != null ? e.trades : "") + '</td><td data-label="Statut"><span class="badge ' + st(e.status) + '">' + (e.status === "JOURNAL" ? "note" : esc(e.status)) + '</span></td><td data-label="Notes" class="wide small text2 break">' + esc(e.notes) + '<div class="xs muted">' + esc(e.source) + "</div></td></tr>";
      }).join("") + "</tbody></table></div>" +
      (rows.length > lim ? '<button class="btn" id="more" style="margin-top:10px">Voir plus (' + (rows.length - lim) + ")</button>" : "") +
      '<p class="xs muted">« Durée » : non enregistrée par les programmes de l\'équipe (pas inventée). « note » = ligne horodatée d\'un journal de bot.</p>';
    el("logt").innerHTML = h;
    if (el("more")) el("more").onclick = function () { STATE.ui.logLimit = lim + 30; renderLog(); };
  }

  // ------------------------------------------------------------ TRADES
  function renderTrades() {
    var T = STATE.data.trades, st = T.stats.all, tab = STATE.ui.tab || "trades", mf = STATE.ui.modeFilter || "all";
    var h = '<h1 class="page-title">Historique des trades</h1><p class="lead">Tous les achats et ventes, en simulation et en réel, avec la raison et la leçon. Les idées refusées sont dans le carnet des décisions.</p>';
    function statsRow(st, title, badge) {
      return '<div class="sec-head" style="margin:14px 0 8px"><h2 style="font-size:1.15rem">' + title + "</h2>" + badge + '</div><div class="grid g5">' +
        statCard("Trades terminés", st.closed, st.open + " en cours") + statCard("Taux de réussite", st.win_rate_pct == null ? "—" : pct(st.win_rate_pct, 0), st.wins + " gagnant(s) · " + st.losses + " perdant(s)") +
        statCard("Gain / perte total", eur(st.realized_pnl_eur, 2, true), "après vente", cls(st.realized_pnl_eur)) +
        statCard("Meilleur trade", st.best ? eur(st.best.pnl_eur, 2, true) : "—", st.best ? esc(st.best.pair) : "", st.best ? cls(st.best.pnl_eur) : "") +
        statCard("Pire trade", st.worst ? eur(st.worst.pnl_eur, 2, true) : "—", st.worst ? esc(st.worst.pair) : "", st.worst ? cls(st.worst.pnl_eur) : "") + "</div>";
    }
    h += statsRow(T.stats.sim, "Simulation", '<span class="badge b-sim">Simulation</span>');
    var R = T.real || {};
    h += R.hidden ? '<div class="notice" style="margin-top:12px">Trades réels masqués (SHOW_REAL=false).</div>' :
      statsRow(T.stats.reel, "Réel", '<span class="badge b-real">Réel · Revolut X</span>') +
      '<p class="xs muted">Réel : calculé depuis l’historique Revolut X depuis le ' + fmtDay(R.project_start) + " (achats et ventes appariés dans l’ordre, frais compris tels que rapportés par Revolut). Les avoirs d’avant ne sont pas des trades." +
      ((R.stats || {}).open_orders_count ? " Ordres en attente : " + R.stats.open_orders_count + "." : "") + "</p>";
    h += '<div class="tabs" style="margin-top:20px"><button class="tab' + (tab === "trades" ? " on" : "") + '" data-t="trades">Trades (' + T.trades.length + ')</button><button class="tab' + (tab === "sf" ? " on" : "") + '" data-t="sf">Vendre d’abord (' + ((T.sell_first || {}).cycles || []).length + ')</button><button class="tab' + (tab === "dec" ? " on" : "") + '" data-t="dec">Carnet des décisions (' + T.decisions.length + ")</button></div>";
    if (tab === "trades") {
      h += '<div class="chips" style="margin-bottom:12px">' + [["all", "Tous"], ["sim", "Simulation"], ["reel", "Réel"]].map(function (m) {
        var n = T.trades.filter(function (t) { return m[0] === "all" || t.mode === m[0]; }).length;
        return '<button class="chip' + (mf === m[0] ? " on" : "") + '" data-m="' + m[0] + '">' + m[1] + ' <span class="n">' + n + "</span></button>";
      }).join("") + "</div>";
      var rows = T.trades.filter(function (t) { return mf === "all" || t.mode === mf; });
      h += rows.length ? '<div class="table-wrap"><table class="rtable"><thead><tr><th>Type</th><th>Paire</th><th>Achat</th><th>Vente</th><th class="num">Montant</th><th class="num">Gain / perte</th><th>Statut</th><th>Raison · leçon</th></tr></thead><tbody>' +
        rows.map(function (t) {
          var org = t.mode === "reel" ? (t.origin === "bot" ? ' <span class="badge b-info">bot</span>' : t.origin ? ' <span class="badge b-mute">' + esc(t.origin) + "</span>" : "") : "";
          return '<tr><td data-label="Type">' + badgeMode(t.mode) + org + (t.kind === "autotest" ? ' <span class="badge b-mute">test</span>' : "") + (t.kind === "order" ? ' <span class="badge b-mute">ordre</span>' : "") + '</td><td data-label="Paire" class="mono">' + esc(t.pair) +
            '</td><td data-label="Achat" class="mono">' + price(t.buy_price) + '<div class="xs muted">' + fmtTime(t.buy_time) + '</div></td><td data-label="Vente" class="mono">' + (t.sell_time ? price(t.sell_price) + '<div class="xs muted">' + fmtTime(t.sell_time) + "</div>" : "—") +
            '</td><td data-label="Montant" class="num">' + eur(t.amount_eur) + (t.qty ? '<div class="xs muted">' + num(t.qty, t.qty < 1 ? 6 : 2) + "</div>" : "") +
            '</td><td data-label="Gain / perte" class="num ' + cls(t.pnl_eur) + '">' + (t.pnl_eur == null ? "—" : eur(t.pnl_eur, 2, true) + '<div class="xs">' + pct(t.pnl_pct, 2, true) + "</div>") +
            '</td><td data-label="Statut"><span class="badge ' + (t.status.indexOf("Vendu") === 0 ? (t.pnl_eur < 0 ? "b-err" : "b-ok") : "b-mute") + '">' + esc(t.status) + "</span>" + (t.stop_price ? '<div class="xs muted">stop ' + price(t.stop_price) + "</div>" : "") +
            '</td><td data-label="Raison · leçon" class="wide small text2 break">' + (t.reason ? "<b>" + (t.kind === "order" ? "Note :" : t.sell_time ? "Pourquoi vendu :" : "Pourquoi acheté :") + "</b> " + esc(t.reason) + "<br>" : "") + (t.bot_reason ? "<b>Raison du bot :</b> " + esc(t.bot_reason) + "<br>" : "") + (t.lesson ? "<b>Leçon :</b> " + esc(t.lesson) : "") + (t.decision_link ? '<div class="xs muted">Décision : ' + esc(t.decision_link) + "</div>" : "") + (t.source ? '<div class="xs muted">' + esc(t.source) + "</div>" : "") + "</td></tr>";
        }).join("") + "</tbody></table></div>" : '<p class="empty">Aucun trade ' + (mf === "reel" ? "réel" : "") + " pour l'instant.</p>";
      h += '<p class="xs muted">Sources — simulation : state/trades_log.jsonl (paper_fill.py) + guardian/state.json ; réel : historique Revolut X (revx order history / transaction list) + state/live_orders.jsonl (live_place.py, ' + ((T.real || {}).live_log_count != null ? T.real.live_log_count : "0") + ' ligne(s)) ; raison et leçon : knowledge/trading_journal.md.</p>';
    } else if (tab === "sf") {
      h += sfSection(T.sell_first, true);
    } else {
      h += T.decisions.map(decCard).join("") || '<p class="empty">Carnet vide.</p>';
      h += '<p class="xs muted">Source : knowledge/decision_log.md (écrit avant chaque achat possible, y compris les refus).</p>';
    }
    el("app").innerHTML = h;
    Array.prototype.forEach.call(document.querySelectorAll(".tab"), function (b) { b.onclick = function () { STATE.ui.tab = b.getAttribute("data-t"); renderTrades(); }; });
    Array.prototype.forEach.call(document.querySelectorAll("[data-m]"), function (b) { b.onclick = function () { STATE.ui.modeFilter = b.getAttribute("data-m"); renderTrades(); }; });
  }
  function decCard(x) {
    var yes = x.decision === "ACHETER" || x.decision === "VENDRE";
    return '<div class="card dec ' + (yes ? "yes" : "no") + '" style="margin-bottom:10px"><div class="card-title" style="margin-bottom:4px"><div><span class="mono"><b>' + esc(x.id) + "</b> · " + esc(x.pair) + '</span> <span class="xs muted">' + esc(x.time_text) + "</span></div>" +
      '<div class="chips">' + badgeMode(x.mode) + (x.kind === "sell_first" ? '<span class="badge b-info">vendre d’abord</span>' : "") + '<span class="badge ' + (yes ? "b-ok" : "b-err") + '">' + esc(x.decision) + "</span></div></div>" +
      (x.idea && !x.title ? '<div class="small"><b>' + esc(x.idea) + "</b></div>" : "") +
      (x.title ? '<div class="small"><b>' + esc(x.title) + "</b></div>" : "") +
      (x.why ? '<p class="why"><b>Pourquoi :</b> ' + esc(x.why) + "</p>" : (x.decision_text ? '<p class="why">' + esc(x.decision_text) + "</p>" : "")) +
      (x.gate_3x ? '<p class="why"><b>Gain ≥ 3× coût ?</b> ' + esc(x.gate_3x) + "</p>" : "") +
      (x.forecast ? '<p class="why"><b>Prévision :</b> ' + esc(x.forecast) + "</p>" : "") +
      (x.backtest ? '<p class="why"><b>Test du passé :</b> ' + esc(x.backtest) + "</p>" : "") +
      (x.score ? '<p class="why"><b>Résultat :</b> ' + esc(x.score) + "</p>" : "") +
      '<details><summary>Tout le détail</summary><div class="inner md"><ul>' + x.bullets.map(function (b) { return "<li>" + b + "</li>"; }).join("") + "</ul></div></details></div>";
  }

  // ------------------------------------------------------------ PERFORMANCE
  function renderPerformance() {
    var P = STATE.data.performance, st = P.stats.sim, e = P.equity, sc = P.scorecard || {}, g = P.go_nogo || {};
    var h = '<h1 class="page-title">Performance</h1><p class="lead">Comment évolue le portefeuille simulé, comparé à « acheter du Bitcoin et ne rien faire » sur la même période.</p>';
    var ours = P.paper.total_return_pct;
    h += '<div class="grid g4">' + statCard("Gain / perte cumulé", eur(st.realized_pnl_eur, 2, true), "simulation, après vente", cls(st.realized_pnl_eur)) +
      statCard("Taux de réussite", st.win_rate_pct == null ? "—" : pct(st.win_rate_pct, 0), st.wins + " / " + st.closed + " trades") +
      statCard("Nombre de trades", st.closed, st.open + " en cours") +
      statCard("Plus grosse baisse", pct(e.max_drawdown_pct, 2), "depuis le sommet (limite 8 %)") +
      statCard("Meilleur trade", st.best ? eur(st.best.pnl_eur, 2, true) : "—", st.best ? esc(st.best.pair) : "", st.best ? cls(st.best.pnl_eur) : "") +
      statCard("Pire trade", st.worst ? eur(st.worst.pnl_eur, 2, true) : "—", st.worst ? esc(st.worst.pair) : "", st.worst ? cls(st.worst.pnl_eur) : "") +
      statCard("Nous (simulation)", pct(ours, 2, true), "depuis le " + fmtDay(e.start), cls(ours)) +
      statCard("Garder du BTC", pct(e.hold_return_pct, 2, true), e.btc_start ? "de " + price(e.btc_start) + " à " + price(e.btc_end) : "données indisponibles", cls(e.hold_return_pct)) + "</div>";
    // Argent réel (mêmes mesures que la simulation)
    var RL = P.real || {};
    h += '<section class="section">' + secHead("Argent réel", "Revolut X, depuis le " + fmtDay(RL.project_start)) +
      (RL.hidden ? '<div class="notice">Masqué (SHOW_REAL=false).</div>' : '<div class="card"><div class="flow" style="justify-content:space-between;margin-bottom:10px"><span class="badge b-real">Réel</span><span class="xs muted">Total estimé ' + eur(RL.total_eur) + " (Revolut X + MetaMask)</span></div>" + realStatsKv(RL.stats) +
        '<p class="xs muted" style="margin:8px 0 0">' + (((RL.stats || {}).closed || 0) === 0 ? "Aucun trade réel terminé depuis le début du projet : tout est à 0. " : "") + "Les avoirs de départ (achats d’avant le projet, staking) ne comptent pas comme des trades.</p></div>" +
        '<div class="grid g2" style="margin-top:12px">' + equityCard(P.live_equity) + sellableCard(P.sellable) + "</div>") + "</section>";
    h += '<section class="section">' + secHead("Vendre d’abord, racheter plus bas", "idée D-018 · résultat en pièces et en euros") + sfSection(P.sell_first, false) +
      '<h3 style="margin-top:18px">Tests du passé de cette idée</h3>' + srTestsHtml(P.sellrebuy_tests, P.sellrebuy_duplicates) + "</section>";
    // Les cryptos qu'on trade
    var PR = P.pairs || {}, pk = Object.keys(PR), cur = STATE.ui.pair && PR[STATE.ui.pair] ? STATE.ui.pair : pk[1] || pk[0];
    STATE.ui.pair = cur;
    h += '<section class="section">' + secHead("Les cryptos qu’on trade", "prix sur 7 jours + nos achats et ventes") +
      '<div class="tabs" id="pairtabs">' + pk.map(function (k) { return '<button class="tab' + (k === cur ? " on" : "") + '" data-p="' + k + '">' + k.replace("-EUR", "") + " <span class='muted'>/ EUR</span></button>"; }).join("") + '</div><div id="pairbox"></div></section>';
    h += '<section class="section">' + secHead("Courbe du portefeuille", "simulation vs garder du BTC (" + num(P.paper.invested_eur, 0) + " € au départ)") + '<div class="card"><div class="chart-box"><canvas id="eq"></canvas></div><p class="xs muted" style="margin:8px 0 0">Heure par heure. Le portefeuille ne bouge que quand un trade est vendu (aucune position ouverte). BTC : prix Revolut X.</p></div></section>';
    h += '<section class="section">' + secHead("Score des prévisions", "noté par PM-Compound") + '<div class="grid g4">' + statCard("Gagnées", sc.gagne != null ? sc.gagne : "—", "", "pos") + statCard("Perdues", sc.perdu != null ? sc.perdu : "—", "", "neg") + statCard("Annulées", sc.annule != null ? sc.annule : "—", "pas mesurables") + statCard("Réussite", sc.taux || "—", "gagnées / (gagnées + perdues)") + "</div></section>";
    var goals = [["Trades d'essai", st.closed, g.min_trades, st.closed + " / " + g.min_trades], ["Taux de réussite", st.win_rate_pct || 0, (g.min_win_rate || 0) * 100, pct(st.win_rate_pct, 0) + " / " + pct((g.min_win_rate || 0) * 100, 0)],
      ["Baisse max sous 8 %", e.max_drawdown_pct < (g.max_drawdown_pct || 0.08) * 100 ? 1 : 0, 1, pct(e.max_drawdown_pct, 2) + " (ok si < 8 %)"]];
    h += '<section class="section">' + secHead("Avant de passer au réel", "objectifs de l'équipe (references/go-nogo.md)") + '<div class="grid g3">' + goals.map(function (x) {
      var r = x[2] ? Math.min(1, x[1] / x[2]) : 0;
      return '<div class="card"><div class="label">' + x[0] + '</div><div class="mono" style="margin-bottom:8px">' + x[3] + '</div><div class="bar"><i style="width:' + Math.round(r * 100) + '%"></i></div></div>';
    }).join("") + "</div></section>";
    // Tests sur le passé
    var bt = P.backtests || [];
    h += '<section class="section">' + secHead("Tests sur le passé", "rejoue une idée sur les prix d'avant (outil Vibe-Trading, sans IA)") +
      '<div class="notice" style="margin-bottom:12px">Un bon résultat sur le passé ne garantit rien pour demain. « Garder » = acheter au début et ne rien faire. Règle d\'équipe : gagner après frais, faire mieux que garder, ≥ 20 trades, baisse max &lt; 8 %.</div>' +
      (bt.length ? '<div class="table-wrap"><table class="rtable"><thead><tr><th>Date</th><th>Idée</th><th>Paire</th><th>Frais</th><th class="num">Résultat</th><th class="num">Garder</th><th class="num">Baisse max</th><th class="num">Trades</th><th class="num">Réussite</th><th>Verdict</th></tr></thead><tbody>' +
        bt.slice(0, STATE.ui.btLimit || 12).map(function (b) {
          return '<tr><td data-label="Date" class="mono small">' + fmtTime(b.time) + '</td><td data-label="Idée">' + esc(b.strategy_fr) + '<div class="xs muted">' + esc(b.timeframe) + (b.stop_pct ? " · stop " + b.stop_pct + " % / objectif " + b.target_pct + " %" : "") + " · " + esc((b.period || []).join(" → ")) + "</div>" + (b.summary_fr ? '<div class="xs text2" style="margin-top:3px">' + esc(b.summary_fr) + "</div>" : "") + '</td><td data-label="Paire" class="mono">' + esc(b.pair) +
            '</td><td data-label="Frais" class="small">' + esc(b.costs) + '</td><td data-label="Résultat" class="num ' + cls(b.total_return_pct) + '">' + pct(b.total_return_pct, 1, true) + '</td><td data-label="Garder" class="num ' + cls(b.hold_return_pct) + '">' + pct(b.hold_return_pct, 1, true) +
            '</td><td data-label="Baisse max" class="num">' + pct(b.max_drawdown_pct, 1) + '</td><td data-label="Trades" class="num">' + b.trades + '</td><td data-label="Réussite" class="num">' + pct(b.win_rate_pct, 0) + '</td><td data-label="Verdict" class="wide xs">' + b.verdict.map(function (v) {
              var good = /^(gagne|mieux|baisse max <|assez)/.test(v); return '<span class="badge ' + (good ? "b-ok" : "b-err") + '" style="margin:2px">' + esc(v) + "</span>";
            }).join("") + "</td></tr>";
        }).join("") + "</tbody></table></div>" + (bt.length > (STATE.ui.btLimit || 12) ? '<button class="btn" id="btmore" style="margin-top:10px">Voir tous les tests (' + bt.length + ")</button>" : "") : '<p class="empty">Aucun test trouvé.</p>');
    if ((P.vibe_reports || []).length) {
      h += '<h3 style="margin-top:18px">Autres rapports</h3><ul class="small">' + P.vibe_reports.map(function (r) { return "<li><span class='mono xs'>" + esc(r.file) + "</span> · " + fmtTime(r.time) + (r.line ? " — " + esc(r.line) : "") + "</li>"; }).join("") + "</ul>";
    }
    if ((P.checks || []).length) {
      h += '<h3 style="margin-top:18px">Tests de solidité</h3><div class="grid g2">' + P.checks.map(function (c) {
        var r = c.result || {}, wf = c.walk_forward || {};
        return '<div class="card flat"><div class="mono small"><b>' + esc(c.strategy_fr) + "</b> · " + esc(c.pair) + " " + esc(c.timeframe) + '</div><div class="xs muted">' + esc((c.period || []).join(" → ")) + '</div><div class="kv k3" style="margin-top:10px">' +
          kv("Résultat", '<span class="' + cls(r.total_return_pct) + '">' + pct(r.total_return_pct, 1, true) + "</span>") + kv("Garder", pct(r.buy_hold_return_pct, 1, true)) + kv("Trades", r.trades) + kv("Baisse max", pct(r.max_drawdown_pct, 1)) +
          kv("Périodes gagnantes", wf.n_windows ? wf.profitable_windows + " / " + wf.n_windows : "—") + kv("Frais aller-retour", c.costs ? pct(c.costs.round_trip_pct, 2) : "—") + "</div></div>";
      }).join("") + "</div>";
    }
    h += "</section>";
    el("app").innerHTML = h;
    if (el("btmore")) el("btmore").onclick = function () { STATE.ui.btLimit = 999; renderPerformance(); };
    if (el("srmore")) el("srmore").onclick = function () { STATE.ui.srLimit = 999; renderPerformance(); };
    drawEquity(e);
    STATE.ui.pairLive = renderPair;
    Array.prototype.forEach.call(document.querySelectorAll("#pairtabs .tab"), function (b) { b.onclick = function () { STATE.ui.pair = b.getAttribute("data-p"); Array.prototype.forEach.call(document.querySelectorAll("#pairtabs .tab"), function (x) { x.classList.toggle("on", x === b); }); renderPair(); }; });
    renderPair();
  }

  function fmtMs(ms, withH) { var q = bxParts(new Date(ms)); return String(q.d).padStart(2, "0") + "/" + String(q.m).padStart(2, "0") + (withH ? " " + q.h + "h" + String(q.mi).padStart(2, "0") : ""); }
  function renderPair() {
    var P = STATE.data.performance, k = STATE.ui.pair, d = (P.pairs || {})[k]; if (!d || !el("pairbox")) return;
    var lp = livePrices(), live = (lp.pairs || {})[k] || {}, px = live.mid || d.price, st = d.stats, ho = d.holdings || {};
    function modeBox(mode) {
      var x = st[mode] || {}, hh = ho[mode];
      if (mode === "reel" && !hh) return '<div class="card flat"><div class="card-title"><h3>Réel</h3><span class="badge b-real">Réel</span></div><p class="small muted">Masqué.</p></div>';
      return '<div class="card flat"><div class="card-title"><h3>' + (mode === "sim" ? "Simulation" : "Réel") + "</h3>" + badgeMode(mode) + '</div><div class="kv">' +
        kv("Trades terminés", x.closed) + kv("Gain / perte", '<span class="' + cls(x.pnl_eur) + '">' + eur(x.pnl_eur, 2, true) + "</span>") +
        kv("Taux de réussite", x.win_rate_pct == null ? "—" : pct(x.win_rate_pct, 0)) + kv("En cours", x.open) +
        (x.sf_cycles ? kv("Vendre d’abord", x.sf_cycles + " cycle(s) · " + '<span class="' + cls(x.sf_coin_gain) + '">' + (x.sf_coin_gain > 0 ? "+" : "") + coinQty(x.sf_coin_gain) + " " + k.split("-")[0] + "</span> · " + eur(x.sf_eur_gain, 2, true)) : "") +
        kv(mode === "sim" ? "Détenu (simulé)" : "Détenu Revolut X", hh ? num(hh.qty, 6) + '<div class="xs muted">' + eur(hh.value_eur) + (hh.staked ? " · dont " + num(hh.staked, 6) + " en staking" : "") + "</div>" : "—") +
        (mode === "reel" && ho.metamask ? kv("Détenu MetaMask", num(ho.metamask.qty, 6) + '<div class="xs muted">' + eur(ho.metamask.value_eur) + "</div>") : "") + "</div></div>";
    }
    el("pairbox").innerHTML = '<div class="card"><div class="flow" style="justify-content:space-between;align-items:baseline"><div><div class="label">' + esc(k) + ' · prix actuel</div><div class="big">' + price(px) + "</div></div>" +
      '<div class="small mono"><span class="' + cls(live.change_24h_pct) + '">24 h ' + pct(live.change_24h_pct, 2, true) + '</span> · <span class="' + cls(d.change_7d_pct) + '">7 j ' + pct(d.change_7d_pct, 2, true) + "</span></div></div>" +
      '<div class="xs muted" style="margin:4px 0 8px">7 j : bas ' + price(d.low_7d) + " · haut " + price(d.high_7d) + " · " + esc(priceAgeText(lp)) + "</div>" +
      '<div class="chart-box"><canvas id="pc"></canvas></div>' +
      '<div class="chips xs" style="margin-top:8px"><span class="badge b-sim">▲ achat simulé</span><span class="badge b-sim">▼ vente simulée</span><span class="badge b-real">▲ achat réel</span><span class="badge b-real">▼ vente réelle</span></div>' +
      '<p class="xs muted" style="margin:8px 0 0">Sources : ' + esc((d.sources || []).join(" + ")) + "." + (d.markers.length ? "" : " Aucun achat ni vente sur cette période.") + (d.markers_outside ? " " + d.markers_outside + " point(s) plus ancien(s) que 7 jours non affiché(s)." : "") + "</p></div>" +
      '<div class="grid g2" style="margin-top:12px">' + modeBox("sim") + modeBox("reel") + "</div>";
    drawPair(d, k);
  }
  function drawPair(d, k) {
    if (!window.Chart || !el("pc")) return;
    if (charts.pc) charts.pc.destroy();
    var narrow = window.innerWidth < 640;
    function mk(mode, side) { return d.markers.filter(function (m) { return m.mode === mode && m.side === side; }).map(function (m) { return { x: m.x, y: m.y, m: m }; }); }
    var col = { sim: "#a78bfa", reel: "#f59e0b" };
    var ds = [{ label: k, data: d.series.map(function (p) { return { x: p[0], y: p[1] }; }), borderColor: "#38bdf8", backgroundColor: "#38bdf814", fill: true, pointRadius: 0, borderWidth: 1.6, tension: 0.15, order: 5 }];
    [["sim", "achat"], ["sim", "vente"], ["reel", "achat"], ["reel", "vente"]].forEach(function (c) {
      var data = mk(c[0], c[1]); if (!data.length) return;
      ds.push({ type: "scatter", label: c[1] === "achat" ? (c[0] === "sim" ? "Achat simulé" : "Achat réel") : (c[0] === "sim" ? "Vente simulée" : "Vente réelle"), data: data, pointStyle: "triangle", rotation: c[1] === "vente" ? 180 : 0,
        pointRadius: narrow ? 7 : 9, pointHoverRadius: 11, backgroundColor: col[c[0]], borderColor: c[1] === "achat" ? "#22c55e" : "#ef4444", borderWidth: 2, order: 1 });
    });
    charts.pc = new Chart(el("pc"), {
      type: "line", data: { datasets: ds },
      options: { responsive: true, maintainAspectRatio: false, animation: false, parsing: true, interaction: { mode: "nearest", intersect: false },
        plugins: { legend: { display: false }, tooltip: { callbacks: {
          title: function (it) { return it.length ? fmtMs(it[0].parsed.x, true) : ""; },
          label: function (c) { var m = c.raw && c.raw.m; return m ? c.dataset.label + (m.sf ? " (vendre d’abord)" : "") + " : " + price(m.y) + (m.amount_eur ? " (" + eur(m.amount_eur) + ")" : "") : k + " : " + price(c.parsed.y); } } } },
        scales: { x: { type: "linear", min: d.series.length ? d.series[0][0] : undefined, max: d.series.length ? Math.max(d.series[d.series.length - 1][0], d.markers.reduce(function (a, m) { return Math.max(a, m.x); }, 0)) : undefined, ticks: { maxTicksLimit: narrow ? 4 : 8, maxRotation: 0, callback: function (v) { return fmtMs(v, false); } }, grid: { color: "#ffffff0a" } },
          y: { ticks: { callback: function (v) { return num(v, v >= 1000 ? 0 : 1) + " €"; } }, grid: { color: "#ffffff0a" } } } }
    });
  }

  function drawEquity(e) {
    if (!window.Chart || !el("eq")) return;
    var labels = e.labels.map(function (l) { var q = bxParts(new Date(l)); return String(q.d).padStart(2, "0") + "/" + String(q.m).padStart(2, "0") + " " + q.h + "h"; });
    var narrow = window.innerWidth < 640;
    if (charts.eq) charts.eq.destroy();
    Chart.defaults.color = "#8da0b8"; Chart.defaults.font.family = "ui-monospace, Menlo, monospace"; Chart.defaults.font.size = 11;
    charts.eq = new Chart(el("eq"), {
      type: "line",
      data: { labels: labels, datasets: [
        { label: "Portefeuille simulé", data: e.equity, borderColor: "#22c55e", backgroundColor: "#22c55e22", fill: true, stepped: true, pointRadius: 0, borderWidth: 2 },
        { label: "Garder du BTC", data: e.hold_btc, borderColor: "#f59e0b", borderDash: [5, 4], pointRadius: 0, borderWidth: 1.5, fill: false } ] },
      options: { responsive: true, maintainAspectRatio: false, animation: false, interaction: { mode: "index", intersect: false },
        plugins: { legend: { labels: { boxWidth: 12 } }, tooltip: { callbacks: { label: function (c) { return c.dataset.label + " : " + eur(c.parsed.y); } } } },
        scales: { x: { ticks: { maxTicksLimit: narrow ? 4 : 8, maxRotation: 0, autoSkipPadding: 12 }, grid: { color: "#ffffff0a" } }, y: { ticks: { callback: function (v) { return num(v, 0) + " €"; } }, grid: { color: "#ffffff0a" } } } }
    });
  }

  // ------------------------------------------------------------ RESEARCH
  function fgFr(v) { return v == null ? "—" : v <= 24 ? "Peur extrême" : v <= 44 ? "Peur" : v <= 55 ? "Neutre" : v <= 75 ? "Avidité" : "Avidité extrême"; }
  function fgColor(v) { return v <= 24 ? "#ef4444" : v <= 44 ? "#f97316" : v <= 55 ? "#eab308" : v <= 75 ? "#84cc16" : "#22c55e"; }
  function objToHtml(o) {
    if (o == null) return "";
    if (typeof o !== "object") return esc(o);
    if (Array.isArray(o)) return "<ul>" + o.map(function (x) { return "<li>" + objToHtml(x) + "</li>"; }).join("") + "</ul>";
    return "<ul>" + Object.keys(o).map(function (k) { return "<li><b>" + esc(k.replace(/_/g, " ")) + " :</b> " + objToHtml(o[k]) + "</li>"; }).join("") + "</ul>";
  }
  function renderResearch() {
    var R = STATE.data.research, fg = R.fear_greed, lr = R.last_research || {}, lp = R.last_predict || {};
    var h = '<h1 class="page-title">Analyses</h1><p class="lead">Le point marché de PM-Research, les avis de PM-Predict et l\'humeur générale du marché.</p><div class="grid g2">';
    if (fg && fg.fear_greed_now) {
      var v = fg.fear_greed_now.value, l7 = ((fg.history || {}).last_7 || []).slice().reverse();
      h += '<div class="card"><div class="card-title"><h3>Humeur du marché</h3><span class="xs muted">Fear &amp; Greed · 0 = peur, 100 = avidité</span></div><div class="gauge"><div class="val" style="color:' + fgColor(v) + '">' + v + '</div><div><div class="mid">' + fgFr(v) + '</div><div class="xs muted">moyenne 30 j : ' + num((fg.history || {}).avg, 1) + "</div></div></div>" +
        '<div class="fg-bars" style="margin-top:12px">' + l7.map(function (x) { return '<div title="' + esc(x.date) + " : " + x.value + '" style="height:' + x.value + '%;background:' + fgColor(x.value) + '"></div>'; }).join("") + '</div><div class="flow xs muted" style="justify-content:space-between"><span>' + esc((l7[0] || {}).date || "") + "</span><span>" + esc((l7[l7.length - 1] || {}).date || "") + "</span></div>" +
        '<div class="xs muted" style="margin-top:6px">Vaut pour toutes les cryptos (surtout BTC). Source : alternative.me' + (fg.fetched_at ? " · lu " + ago(fg.fetched_at) : "") + "</div></div>";
    } else h += '<div class="card"><h3>Humeur du marché</h3><p class="empty">Indisponible.</p></div>';
    h += '<div class="card"><div class="card-title"><h3>Dernier point PM-Research</h3><span class="xs muted">' + fmtTime(lr.briefed_at) + "</span></div>" +
      '<div class="small text2">' + esc(lr.cycle || "") + (lr.prix ? ' · <span class="warn">Prix : ' + esc(lr.prix) + "</span>" : "") + '</div><div class="md small">' + objToHtml(lr.resume) + "</div>" + (lr.sources_note ? '<div class="xs muted">' + esc(lr.sources_note) + "</div>" : "") + "</div></div>";
    h += '<section class="section">' + secHead("Avis PM-Predict", "dernier cycle : " + fmtTime(lp.predicted_at)) + '<div class="card">' + '<div class="small text2">' + esc(lp.cycle || "") + "</div>" +
      (lp.signals ? '<div class="table-wrap"><table class="rtable"><thead><tr><th>Décision</th><th>Paire</th><th class="num">Dernier prix</th><th>Avis</th><th>Mesurable</th></tr></thead><tbody>' + lp.signals.map(function (s) {
        return '<tr><td data-label="Décision" class="mono">' + esc(s.decision_id) + '</td><td data-label="Paire" class="mono">' + esc(s.pair) + '</td><td data-label="Dernier prix" class="num">' + price(s.mid_eur) + (s.mid_stale ? ' <span class="badge b-warn">ancien</span>' : "") + '</td><td data-label="Avis"><span class="badge ' + (s.decision === "NO_TRADE" ? "b-err" : "b-ok") + '">' + (s.decision === "NO_TRADE" ? "Pas acheter" : esc(s.decision)) + '</span></td><td data-label="Mesurable">' + (s.measurable ? "oui" : "non") + "</td></tr>";
      }).join("") + "</tbody></table></div>" : "") + (lp.handoff ? '<p class="small text2"><b>Passage de relais :</b> ' + esc(lp.handoff) + "</p>" : "") + "</div>" +
      '<h3 style="margin-top:16px">Dernières décisions écrites</h3>' + (R.decisions_latest || []).slice(0, 4).map(decCard).join("") + '<a href="trades.html" class="small">→ Tout le carnet des décisions</a></section>';
    var t = R.scorecard.totals || {};
    h += '<section class="section">' + secHead("Score des prévisions", "mis à jour " + ago(R.scorecard.updated)) + '<div class="chips" style="margin-bottom:8px"><span class="badge b-ok">Gagnées ' + (t.gagne != null ? t.gagne : "—") + '</span><span class="badge b-err">Perdues ' + (t.perdu != null ? t.perdu : "—") + '</span><span class="badge b-mute">Annulées ' + (t.annule != null ? t.annule : "—") + '</span><span class="badge b-info">Réussite ' + esc(t.taux || "—") + '</span></div><details><summary>Détail du score</summary><div class="inner md">' + R.scorecard.html + "</div></details></section>";
    h += '<section class="section">' + secHead("Archives des points marché", (R.briefs || []).length + " points") + (R.briefs || []).map(function (b, i) {
      return "<details" + (i === 0 ? " open" : "") + "><summary><span>" + fmtTime(b.time) + " · " + esc((b.data && b.data.cycle) || "Point marché") + '</span></summary><div class="inner md">' + (b.html || "") + (b.data ? objToHtml(b.data.resume || b.data) : "") + '<div class="xs muted">' + esc(b.files.join(", ")) + "</div></div></details>";
    }).join("") + "</section>";
    h += '<section class="section">' + secHead("Journaux des bots", "ce que chaque bot a noté") + Object.keys(R.journals || {}).map(function (k) {
      var j = R.journals[k]; return "<details><summary><span>" + esc(k.replace("pm-", "PM-").replace(/-(\w)/, function (m, c) { return "-" + c.toUpperCase(); })) + '</span><span class="xs muted">' + ago(j.updated) + '</span></summary><div class="inner md">' + j.html + "</div></details>";
    }).join("") + "<details><summary><span>Journal des échecs</span><span class=\"xs muted\">" + ago((R.failure_log || {}).updated) + '</span></summary><div class="inner md">' + ((R.failure_log || {}).html || "") + "</div></details></section>";
    el("app").innerHTML = h;
  }

  // ------------------------------------------------------------ NEWS
  function renderNews() {
    var N = STATE.data.news, src = STATE.ui.src || "Tous", tag = STATE.ui.tag || "";
    var items = (N.items || []).filter(function (x) { return (src === "Tous" || x.source === src) && (!tag || x.tags.indexOf(tag) >= 0); });
    var counts = {}; (N.items || []).forEach(function (x) { counts[x.source] = (counts[x.source] || 0) + 1; });
    var h = '<h1 class="page-title">Actualités <span class="badge ' + (newsFresh(N) ? "b-ok" : "b-warn") + '" style="vertical-align:middle"><span class="dot' + (newsFresh(N) ? " ok" : "") + '"></span>' + ago(N.generated_at) + '</span></h1><p class="lead">Les titres de CoinDesk, CoinTelegraph et Decrypt (en anglais), relus toutes les 5 minutes' + (hosted() ? " (ici, version en ligne publiée toutes les ~" + (STATE.deploy.interval_min || 15) + " min)" : "") + '. Les articles qui parlent de BTC, ETH ou SOL sont mis en avant.</p>';
    h += '<div class="chips" style="margin-bottom:8px">' + ["Tous", "CoinDesk", "CoinTelegraph", "Decrypt"].map(function (s) {
      return '<button class="chip' + (s === src ? " on" : "") + '" data-s="' + s + '">' + s + ' <span class="n">' + (s === "Tous" ? (N.items || []).length : counts[s] || 0) + "</span></button>";
    }).join("") + '</div><div class="chips" style="margin-bottom:16px">' + ["BTC", "ETH", "SOL"].map(function (t) {
      return '<button class="chip' + (t === tag ? " on" : "") + '" data-g="' + t + '">' + t + ' <span class="n">' + (N.items || []).filter(function (x) { return x.tags.indexOf(t) >= 0; }).length + "</span></button>";
    }).join("") + "</div>";
    var bad = Object.keys(N.sources || {}).filter(function (k) { return !N.sources[k].ok; });
    if (bad.length) h += '<div class="notice warn" style="margin-bottom:12px">Source(s) injoignable(s) au dernier passage : ' + esc(bad.join(", ")) + " (anciens titres gardés).</div>";
    if (!items.length) h += '<p class="empty">Aucun article.</p>';
    else {
      var top = items[0];
      h += '<a class="news-item news-top' + (top.tags.length ? " hl" : "") + '" href="' + esc(top.link) + '" target="_blank" rel="noopener noreferrer"><div class="meta"><span class="badge b-info">À la une</span><span>' + esc(top.source) + "</span><span>" + ago(top.published) + "</span>" + tagsHtml(top) + "</div><h3>" + esc(top.title) + "</h3><p>" + esc(top.summary) + '</p><div class="small" style="margin-top:8px;color:var(--info)">Lire l\'article ↗</div></a>';
      h += '<div class="grid g2" style="margin-top:12px">' + items.slice(1, 80).map(function (x) {
        return '<a class="news-item' + (x.tags.length ? " hl" : "") + '" href="' + esc(x.link) + '" target="_blank" rel="noopener noreferrer"><div class="meta"><span>' + esc(x.source) + "</span><span>" + ago(x.published) + '</span><span class="muted">' + fmtTime(x.published) + "</span>" + tagsHtml(x) + "</div><h3>" + esc(x.title) + "</h3><p>" + esc(x.summary) + "</p></a>";
      }).join("") + "</div>";
    }
    h += '<p class="xs muted" style="margin-top:14px">Liste mise à jour ' + ago(N.generated_at) + "." + (hosted() ? "" : " Aussi disponible pour les bots : /workspace/dashboard/data/news.json") + "</p>";
    el("app").innerHTML = h;
    Array.prototype.forEach.call(document.querySelectorAll("[data-s]"), function (b) { b.onclick = function () { STATE.ui.src = b.getAttribute("data-s"); renderNews(); }; });
    Array.prototype.forEach.call(document.querySelectorAll("[data-g]"), function (b) { b.onclick = function () { var g = b.getAttribute("data-g"); STATE.ui.tag = STATE.ui.tag === g ? "" : g; renderNews(); }; });
  }
  function newsFresh(N) { var a = N && N.generated_at ? (Date.now() - new Date(N.generated_at).getTime()) / 60000 : 1e9; return a < (hosted() ? 40 : 15); }
  function tagsHtml(x) { return x.tags.map(function (t) { return '<span class="badge b-ok">' + t + "</span>"; }).join(""); }

  // ------------------------------------------------------------ ABOUT
  function renderAbout() {
    var s = STATE.data.summary, ru = s.rules;
    var team = [["PM-Scan", "Relève les prix de BTC, ETH et SOL en euros et signale ce qui bouge anormalement."], ["PM-Research", "Lit les nouvelles et résume l'ambiance du marché en français simple."],
      ["PM-Predict", "Dit pour chaque crypto « acheter » ou « ne pas acheter », avec une prévision qu'on peut vérifier."], ["PM-Risk", "Le gardien : accepte ou refuse chaque achat et surveille les pertes."],
      ["PM-Compound", "Fait le bilan après chaque vente, note les prévisions et tire les leçons."], ["PM-Orchestrator", "Le chef d'orchestre : fait passer le relais entre les autres."]];
    var h = '<h1 class="page-title">À propos</h1><p class="lead">PM Pipeline est une petite équipe de programmes qui apprend à trader des cryptos prudemment. Ce site montre tout ce qu\'elle fait, en simulation comme en réel, sans rien cacher.</p>';
    h += '<section class="section">' + secHead("L'équipe", "qui fait quoi") + '<div class="grid g3">' + team.map(function (t) { return '<div class="card"><h3 class="mono">' + t[0] + '</h3><p class="small text2" style="margin:0">' + t[1] + "</p></div>"; }).join("") + "</div>" +
      '<div class="notice" style="margin-top:12px">Le chemin d\'une idée : <b>Scan</b> (prix) → <b>Research</b> (contexte) → <b>Predict</b> (avis écrit) → <b>Risk</b> (oui / non) → achat → vente → <b>Compound</b> (bilan et leçon).</div></section>';
    h += '<section class="section">' + secHead("Simulation ou réel ?", "") + '<div class="grid g2"><div class="card"><div class="card-title"><h3>Simulation</h3><span class="badge b-sim">Simulation</span></div><p class="small text2">Argent fictif (départ ' + eur(s.paper.invested_eur, 0) + "). Sert à s'entraîner et à mesurer si une idée marche, sans risque. Maximum ~" + ru.sim_max_eur + " € par trade.</p></div>" +
      '<div class="card"><div class="card-title"><h3>Réel</h3><span class="badge b-real">Réel</span></div><p class="small text2">Vrai argent sur Revolut X. Très rare : au maximum ' + ru.max_live_per_day + " achat réel par jour, à partir de " + ru.live_min_eur + " €, seulement si toutes les règles sont respectées. MetaMask sert de coffre et est en pause pour le trading.</p></div></div></section>";
    h += '<section class="section">' + secHead("Les règles", "verrouillées le 7 octobre 2026") + '<div class="card"><ol class="small" style="margin:0;padding-left:20px;line-height:1.8">' +
      "<li><b>Faire grandir le capital</b> (gain net, après les frais).</li><li><b>Ne jamais faire faillite.</b></li>" +
      "<li>Avant chaque achat : écrire le gain espéré, la perte maximale et le coût. On achète seulement si le gain espéré fait au moins <b>" + ru.expectancy_multiple + "× les coûts</b>.</li>" +
      "<li>Au maximum <b>" + num(ru.max_position_pct, 0) + " %</b> du capital par achat ; BTC, ETH et SOL bougent ensemble, donc au total <b>" + num(ru.max_exposure_pct, 0) + " %</b> maximum sur les trois.</li>" +
      "<li>Perte de <b>" + num(ru.max_daily_loss_pct, 0) + " %</b> sur la journée → on arrête pour la journée.</li><li>Baisse de <b>" + num(ru.max_drawdown_pct, 0) + " %</b> depuis le plus haut → on arrête tout.</li>" +
      "<li>Pas d'emprunt, pas d'ordre « au prix du marché » : seulement des ordres à prix fixé qui attendent.</li><li>Cryptos autorisées : <b>" + esc((ru.pairs || []).join(", ")) + "</b>.</li>" +
      "<li>Toute nouvelle idée est d'abord rejouée sur 1 an de prix passés, frais compris.</li><li>Deux carnets obligatoires : le carnet des décisions (avant achat, même les refus) et le journal des trades (après vente).</li></ol></div></section>";
    h += '<section class="section">' + secHead("Comment marche ce site", "") + '<div class="card small text2"><p style="margin-top:0">Un petit script (build.py) relit toutes les 5 minutes les fichiers de l\'équipe, les prix publics, les soldes (en lecture seule) et les flux d\'actualités, puis fabrique ce site. <b>Aucune IA n\'est utilisée</b> pour le site et aucun ordre ne peut être passé d\'ici. Les pages se rechargent toutes les 60 secondes. Toutes les heures sont celles de Bruxelles.' + (hosted() ? " <b>Version en ligne</b> : une copie est publiée sur Cloudflare Pages toutes les ~" + (STATE.deploy.interval_min || 15) + " min (dernière publication " + ago(STATE.deploy.deployed_at) + "), protégée par mot de passe ; les chiffres peuvent donc avoir jusqu'à ~15 min de retard." : "") + '</p>' +
      "<p>Les soldes réels et l'adresse du portefeuille sont privés : ils ne s'affichent que si l'option SHOW_REAL est activée (actuellement : <b>" + (s.show_real ? "activée" : "désactivée") + "</b>). " + (hosted() ? "Cette version en ligne est protégée par identifiant et mot de passe." : "Pour une version en ligne, il faut la désactiver ou protéger le site par un mot de passe.") + "</p>" +
      "<p style='margin-bottom:0'>Inspiré de la mise en page d'un tableau de bord de trading public ; données, textes et code propres à PM Pipeline. Ce n'est pas un conseil financier.</p></div></section>";
    el("app").innerHTML = h;
  }

  // ------------------------------------------------------------ boot
  // Sur mobile les tableaux deviennent des cartes : chaque cellule a un libellé + une valeur emballée.
  function wrapCells(root) {
    Array.prototype.forEach.call((root || document).querySelectorAll("table.rtable td:not([data-w])"), function (td) {
      td.setAttribute("data-w", "1");
      if (!td.firstChild) return;
      var v = document.createElement("div"); v.className = "cv";
      while (td.firstChild) v.appendChild(td.firstChild);
      td.appendChild(v); td.setAttribute("data-w", "1");
    });
  }
  var mo = new MutationObserver(function () { wrapCells(document); });
  mo.observe(document.getElementById("app"), { childList: true, subtree: true });
  function renderPage() {
    try {
      ({ index: renderHome, trades: renderTrades, performance: renderPerformance, research: renderResearch, news: renderNews, about: renderAbout }[PAGE] || renderHome)();
    } catch (e) { el("app").innerHTML = '<div class="notice warn">Erreur d\'affichage : ' + esc(e.message) + "</div>"; console.error(e); }
  }
  function refreshPrices() {
    return load("prices").then(function (d) { STATE.data.prices = d; renderPriceBar(); if (PAGE === "performance" && STATE.ui.pairLive) STATE.ui.pairLive(); }).catch(function () {});
  }
  function loadDeploy() { return load("deploy").then(function (d) { STATE.deploy = d; }).catch(function () { STATE.deploy = null; }); }
  loadDeploy().then(refresh).then(refreshPrices);
  setInterval(loadDeploy, 300000);
  setInterval(refresh, 60000);            // données rechargées toutes les 60 s
  setInterval(refreshPrices, 30000);      // prix en direct toutes les 30 s
  setInterval(function () { if (el("pxage")) { var lp = livePrices(), a = tickAge(lp); el("pxage").textContent = priceAgeText(lp) + (a != null && a > 120 ? " · ancien" : ""); el("pxage").className = "pp " + (a == null || a > 120 ? "warn" : "muted"); } }, 5000);
  setInterval(function () {                // « il y a X min » + barres de progression
    if (el("upd")) el("upd").textContent = updText();
    if (PAGE === "index" && STATE.data.summary && el("cycles")) el("cycles").innerHTML = STATE.data.summary.cycles.map(cycleCard).join("");
  }, 15000);
  window.addEventListener("resize", function () { if (charts.eq) charts.eq.resize(); if (charts.pc) charts.pc.resize(); });
})();
